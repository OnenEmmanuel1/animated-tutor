<%- include('../partials/header', { title: lesson.title, bodyClass: 'ntut-learner-body' }) %>
<%- include('../partials/nav', { isLearnerView: true, backUrl: '/learner-dashboard', learner: learner }) %>

<main class="ntut-main-content">
  <div style="text-align: center; margin-bottom: 1rem;">
    <h1 class="ntut-h1" style="font-family: var(--ntut-font-kid); font-weight: 900; font-size: 2.25rem; color: var(--ntut-dark); margin-bottom: 0;">
      <%= lesson.title %>
    </h1>
    <div id="step-tracker" style="font-size: 1.25rem; font-weight: 900; color: var(--ntut-text-muted);">
      Click below to begin!
    </div>
  </div>

  <div class="ntut-canvas-container">
    <!-- Lesson Canvas Screen -->
    <div class="ntut-canvas" id="lesson-canvas">
      <!-- Autoplay Bypass Interactor -->
      <div id="autoplay-start-overlay" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: var(--ntut-kid-blue); display: flex; flex-direction: column; align-items: center; justify-content: center; cursor: pointer; z-index: 10;" onclick="startPlayer()">
        <span class="ntut-start-rocket">🚀</span>
        <span class="ntut-start-btn">
          Tap to Start!
        </span>
      </div>
    </div>

    <!-- Navigation Control Buttons -->
    <div class="ntut-lesson-controls" id="player-controls-panel" style="visibility: hidden;">
      <button class="ntut-control-btn" id="prev-btn" title="Previous Slide">⬅️</button>
      <button class="ntut-control-btn" id="pause-btn" title="Pause Auto-Play" style="display: none;">⏸️</button>
      <button class="ntut-control-btn" id="play-btn" title="Play Auto-Play">▶️</button>
      <button class="ntut-control-btn" id="replay-btn" title="Repeat Sound">🔁</button>
      <button class="ntut-control-btn" id="next-btn" title="Next Slide">➡️</button>
    </div>
  </div>
</main>

<!-- Load Audio and Animation players -->
<script src="/js/audio.js"></script>
<script src="/js/animation.js"></script>
<script>
  let playerInstance = null;

  function startPlayer() {
    // 1. Initialize web audio context
    NtutAudio.initAudio();
    
    // 2. Play starting chime
    NtutAudio.playCue('success');

    // 3. Hide start overlay and make controls visible
    document.getElementById('autoplay-start-overlay').style.display = 'none';
    document.getElementById('player-controls-panel').style.visibility = 'visible';

    // 4. Initialize animation engine instance
    playerInstance = new NtutLessonPlayer('lesson-canvas', '<%= lesson.animation_asset %>', <%= lesson.id %>);
    playerInstance.init();
    
    // Track lesson progress status as "in_progress" in background
    fetch('/api/lessons/<%= lesson.id %>/progress', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ status: 'in_progress' })
    }).catch(err => console.warn('Could not post progress start:', err));

    // Custom controls setup
    const playBtn = document.getElementById('play-btn');
    const pauseBtn = document.getElementById('pause-btn');

    playBtn.addEventListener('click', () => {
      playBtn.style.display = 'none';
      pauseBtn.style.display = 'inline-flex';
    });

    pauseBtn.addEventListener('click', () => {
      pauseBtn.style.display = 'none';
      playBtn.style.display = 'inline-flex';
    });

    // Default to auto-playing
    playBtn.style.display = 'none';
    pauseBtn.style.display = 'inline-flex';
  }

  // Clear speech synthesizer when navigating away from the page
  window.addEventListener('beforeunload', () => {
    NtutAudio.stop();
  });
</script>

<%- include('../partials/footer') %>
