<%- include('../partials/header', { title: 'Register' }) %>
<%- include('../partials/nav') %>

<main class="ntut-main-content" style="display: flex; align-items: center; justify-content: center; min-height: 70vh;">
  <div class="ntut-card" style="width: 100%; max-width: 480px; padding: 2.5rem;">
    <div class="ntut-card-header" style="justify-content: center; border-bottom: none; margin-bottom: 1.5rem;">
      <h1 class="ntut-h1" style="font-family: var(--ntut-font-kid); font-weight: 900; margin-bottom: 0;">Create Account</h1>
    </div>

    <div id="alert-box" style="display: none;"></div>

    <form id="register-form">
      <div class="ntut-form-group">
        <label for="name" class="ntut-form-label">Full Name</label>
        <input type="text" id="name" name="name" class="ntut-form-input" placeholder="John Doe" required autocomplete="name">
      </div>

      <div class="ntut-form-group">
        <label for="email" class="ntut-form-label">Email Address</label>
        <input type="email" id="email" name="email" class="ntut-form-input" placeholder="email@example.com" required autocomplete="email">
      </div>

      <div class="ntut-form-group">
        <label for="role" class="ntut-form-label">Account Role</label>
        <select id="role" name="role" class="ntut-form-select" required>
          <option value="parent" selected>Parent / Guardian</option>
          <option value="teacher_admin">Teacher / Administrator</option>
        </select>
      </div>
      
      <div class="ntut-form-group">
        <label for="password" class="ntut-form-label">Password</label>
        <input type="password" id="password" name="password" class="ntut-form-input" placeholder="••••••••" required autocomplete="new-password">
      </div>

      <button type="submit" class="ntut-btn ntut-btn-primary" style="width: 100%; margin-top: 1rem; font-size: 1.1rem;" id="register-btn-submit">
        Sign Up
      </button>
    </form>

    <div style="text-align: center; margin-top: 1.5rem; font-size: 0.95rem;">
      Already have an account? <a href="/login" style="color: var(--ntut-primary); font-weight: 600;">Log In here</a>
    </div>
  </div>
</main>

<script>
  document.getElementById('register-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = document.getElementById('name').value;
    const email = document.getElementById('email').value;
    const role = document.getElementById('role').value;
    const password = document.getElementById('password').value;
    const alertBox = document.getElementById('alert-box');
    const submitBtn = document.getElementById('register-btn-submit');

    submitBtn.disabled = true;
    submitBtn.innerText = 'Creating account...';

    try {
      const response = await fetch('/api/auth/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin',
        body: JSON.stringify({ name, email, role, password })
      });
      
      const data = await response.json();
      
      if (!response.ok || data.error) {
        alertBox.className = 'ntut-alert ntut-alert-danger';
        alertBox.innerText = data.error || 'Registration failed';
        alertBox.style.display = 'flex';
        submitBtn.disabled = false;
        submitBtn.innerText = 'Sign Up';
      } else {
        alertBox.className = 'ntut-alert ntut-alert-success';
        alertBox.innerText = 'Account created successfully! Redirecting...';
        alertBox.style.display = 'flex';
        
        setTimeout(() => {
          if (data.user.role === 'teacher_admin') {
            window.location.href = '/teacher-dashboard';
          } else {
            window.location.href = '/parent-dashboard';
          }
        }, 800);
      }
    } catch (err) {
      console.error(err);
      alertBox.className = 'ntut-alert ntut-alert-danger';
      alertBox.innerText = 'Network error. Please try again.';
      alertBox.style.display = 'flex';
      submitBtn.disabled = false;
      submitBtn.innerText = 'Sign Up';
    }
  });
</script>

<%- include('../partials/footer') %>
