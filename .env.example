# ─────────────────────────────────────────────────────────────────────────────
# TutorToon – Environment Variables Reference
# Copy this file to .env for local development. Never commit .env to git.
# Set these as Environment Variables in your Vercel project dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# Application
PORT=3004
SESSION_SECRET=replace_with_a_long_random_secret_string

# ── MySQL Database (Aiven) ────────────────────────────────────────────────────
# Find these in: Aiven Console → your MySQL service → Overview tab
#
# Host:     e.g. mysql-abc123-yourname.aivencloud.com
# Port:     e.g. 17074  (Aiven uses a non-standard port — NOT 3306)
# User:     avnadmin
# Password: <shown in Aiven Overview>
# DB Name:  defaultdb
#
DB_HOST=your-mysql-host.aivencloud.com
DB_USER=avnadmin
DB_PASSWORD=your_aiven_password_here
DB_NAME=defaultdb
DB_PORT=your_aiven_port
DB_SSL=true

# ── Redis Session Store (Upstash) ─────────────────────────────────────────────
# Find this in: Upstash Console → your Redis DB → Connect → ioredis section
# Format: rediss://default:<password>@<host>:<port>
REDIS_URL=rediss://default:your_upstash_token@your-upstash-host.upstash.io:6379
